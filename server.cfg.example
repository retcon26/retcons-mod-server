# Retcon's Mod dedicated server settings. Copy this to server.cfg next to retcons-mod-server (or pass
# -c FILE). Anything here can also be given on the command line, e.g. --map gm_flatgrass --port 18300.

# The game's folder: the one with data/ in it (your release's PSP/GAME/RetconsMod, or psp/ in a
# retcons-mod checkout with converted data). Give the server its own copy if you can: it reads the maps
# and packs, and writes saved builds to data/saves.
game_dir ./RetconsMod

# The map to host, and a saved build to load where it was built (data/saves/NAME.build), if any
map gm_construct
#build My Build

# A gamemode: prophunt, zombiesurvival, deathmatch, or one of your own in data/lua/gamemodes (its file name
# without .lua). Leave it out (or "sandbox") for the sandbox. Needs the server built with Lua (see README).
# Saved builds and autosaves are the sandbox's: a gamemode's game doesn't load or save them.
#gamemode prophunt

# Shown in the PSPs' Online Servers list (15 characters at most)
name Retcon's Server

# UDP port. Players add the server as address:port when it isn't 18256 (the game's own port, which
# Online Servers' LAN search uses).
port 18256

# 1: send beacons round the local network too, so PSPs on the same Wi-Fi find the server by themselves
lan 1

# A server list to appear on, so players see this server without typing its address (its port is 18257
# unless you add :port). public_address: the address the list should give players, only when it can't see
# the right one itself (a list on your own network listing this server for players outside it).
#list lists.example.org
#public_address 203.0.113.5

# World updates a second
tick 60

# How many can play at once (1 to 7), and a password to join (no # in it: that starts a comment)
max_players 7
#password secret

# A map rotation: map names with spaces between, and the minutes on each (map is the first one hosted)
#maps gm_construct gm_flatgrass gm_bigcity
map_minutes 30

# The players' build saved this often (minutes, 0: never) as data/saves/auto-<map>.build, and loaded again
# when that map starts
autosave_minutes 5
autosave_resume 1

# The game's options, as the host's are in a PSP-hosted game
god_mode 0
npc_think 1
npc_ignore_players 0
unlimited_ammo 0
physics 3
